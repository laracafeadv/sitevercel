PORT=3001
DATABASE_URL=./data/lara-cafe.db
JWT_SECRET=change-this-to-a-long-random-string
CLIENT_ORIGIN=http://localhost:5173
UPLOAD_DIR=./uploads
NODE_ENV=development

# Login do admin criado pelo seed.
# ADMIN_PASSWORD: defina a sua própria senha aqui. Se deixar em branco, o
# seed gera uma senha aleatória segura e mostra ela uma única vez no log.
ADMIN_EMAIL=admin@laracafeadvocacia.com.br
ADMIN_PASSWORD=

# Aviso por e-mail quando alguém preenche o formulário de contato (opcional).
# EMAIL_USER: sua conta Gmail. EMAIL_APP_PASSWORD: senha de app gerada em
# myaccount.google.com/apppasswords (não é a senha normal da conta).
# NOTIFICATION_EMAIL: para onde o aviso vai (padrão: o próprio EMAIL_USER).
EMAIL_USER=laracafe.adv@gmail.com
EMAIL_APP_PASSWORD=
NOTIFICATION_EMAIL=laracafe.adv@gmail.com
